# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.

# RevenueCat public SDK keys. Without them, purchases are simulated (dev only).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# The Coach API (web/api/coach.js) on Vercel, with /api on the end, e.g. https://your-project.vercel.app/api
EXPO_PUBLIC_COACH_URL=

# PostHog project API key (public). Analytics are off without it.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
